{
  "schemaVersion": 1,
  "id": "disguises",
  "version": "${version}",
  "name": "Disguises",
  "description": "Entity disguise mod for Fabric — disguise players and mobs as any entity type.",
  "authors": ["coffee"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.coffee.disguises.DisguisesMod"],
    "client": ["com.coffee.disguises.client.DisguisesModClient"],
    "modmenu": ["${modmenu_entrypoint}"],
    "disguises:vanish": []
  },
  "mixins": [
    "disguises.mixins.json"
  ],
  "depends": {
    "fabricloader": "${loader_dependency}",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "java": "${java_dependency}"
  },
  "suggests": {
    "cloth-config2": "*",
    "modmenu": "*",
    "luckperms": "*"
  }
}
